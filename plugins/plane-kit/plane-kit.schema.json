{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plane-kit configuration (.claude/plane-kit.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["identifier", "projectId", "workspaceSlug", "baseUrl", "host"],
  "properties": {
    "$schema": { "type": "string" },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*$",
      "description": "Plane project identifier, the prefix of work item ids (ACME-12)."
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "Project UUID, so the skill never operates on another project of the workspace."
    },
    "workspaceSlug": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "pattern": "^https?://", "description": "Plane URL." },
    "host": { "enum": ["gitlab", "github"], "description": "Selects the CI template and how MRs/PRs are read." },
    "devBranch": { "type": "string", "minLength": 1, "description": "Default: dev." },
    "readyState": { "type": "string", "minLength": 1, "description": "Default: Ready For Testing." },
    "movableStates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "States CI may move an item out of. Default: Backlog, Todo, In Progress."
    },
    "agentMaySet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["inProgress", "ready"] },
      "description": "Narrows what the agent may set: inProgress = In Progress, ready = readyState. Default: both. Done is never allowed."
    },
    "language": { "type": "string", "minLength": 1, "description": "Language of comments and items. Default: vi." },
    "branchPattern": {
      "type": "string",
      "minLength": 1,
      "description": "Default: {feature,fix,chore}/<identifier-lowercase>-<n>-<slug>."
    }
  }
}
